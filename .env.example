# HomeCam Configuration Settings

# Network Ports
PORT=8443
HTTP_PORT=8080

# Storage Locations (Host Volume Bind Mounts)
STORAGE_PATH=./media
DB_PATH=./data/homecam.db
CERTS_PATH=./certs

# Retention & Storage Limits
RETENTION_DAYS=14
MAX_STORAGE_GB=50

# Default AI Sensitivity (0.50 to 0.95)
CONFIDENCE_THRESHOLD=0.65

# Enable Automatic Self-Signed SSL Certificate if custom certs aren't found
AUTO_GENERATE_CERTS=true
